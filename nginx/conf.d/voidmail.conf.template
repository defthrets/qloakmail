# QloakMail reverse proxy.
# Local dev: HTTP only on :8080.
# Production: ports 80/443, with cert from /etc/letsencrypt/live/${VOIDMAIL_DOMAIN}/.

# Suppress nginx version in Server: header and default error pages.
# Audit v2 flagged this as a fingerprinting leak (M3). Applies http-wide
# because conf.d/*.conf is included inside nginx's main http {} block.
server_tokens off;

upstream voidmail_api {
    server api:8000;
    keepalive 32;
}

upstream voidmail_web {
    server web:80;
    keepalive 16;
}

# ---- Local dev (HTTP on :8080) ----
server {
    listen 8080 default_server;
    server_name _;

    client_max_body_size 30m;

    location /api/ {
        proxy_pass http://voidmail_api;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection        "";
    }

    location / {
        proxy_pass http://voidmail_web;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
    }
}

# ---- Tor hidden service (HTTP on :80, anything ending in .onion) ----
# Tor provides E2E encryption between client and the hidden-service
# rendezvous, so no TLS on the hop from tor -> nginx -> upstream. We
# strip every header that could correlate the request to a clearnet
# identity (X-Forwarded-For, X-Real-IP), and we don't pass $host
# through to the API so it can't log the .onion either.
server {
    listen 80;
    server_name "~^.+\.onion$";

    client_max_body_size 30m;

    # ---- Security headers (onion) ----
    # HSTS deliberately omitted: HSTS forces HTTPS, but Tor onion
    # routing is plaintext between the rendezvous and our nginx (Tor
    # provides E2E encryption inside the circuit). Everything else
    # mirrors the clearnet HTTPS server.
    add_header X-Frame-Options DENY always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    add_header X-XSS-Protection "0" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; connect-src 'self'; img-src 'self' data:; font-src 'self' data:; media-src 'self' data:; manifest-src 'self'; worker-src 'self'; object-src 'none'; frame-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;
    add_header Cross-Origin-Opener-Policy "same-origin" always;
    add_header Cross-Origin-Resource-Policy "same-origin" always;
    add_header Cross-Origin-Embedder-Policy "require-corp" always;
    add_header Permissions-Policy "accelerometer=(), ambient-light-sensor=(), autoplay=(), battery=(), bluetooth=(), camera=(), clipboard-read=(), clipboard-write=(self), display-capture=(), encrypted-media=(), fullscreen=(self), gamepad=(), geolocation=(), gyroscope=(), hid=(), idle-detection=(), local-fonts=(), magnetometer=(), microphone=(), midi=(), payment=(), picture-in-picture=(), publickey-credentials-get=(self), screen-wake-lock=(), serial=(), storage-access=(), usb=(), web-share=(), xr-spatial-tracking=()" always;

    # Block the internal-only API surface from the public side.
    location /api/v1/internal/ { return 404; }

    location /api/ {
        proxy_pass http://voidmail_api;
        proxy_http_version 1.1;
        # Pass a fixed Host so logs/templates can't pick up the onion.
        proxy_set_header Host                ${VOIDMAIL_DOMAIN};
        proxy_set_header X-Real-IP           "";
        proxy_set_header X-Forwarded-For     "";
        proxy_set_header X-Forwarded-Proto   "https";
        proxy_set_header Connection          "";
    }

    location / {
        proxy_pass http://voidmail_web;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
    }
}

# ---- Production HTTPS ----
# Activated only once Let's Encrypt has issued a cert.
# Comment-out the `ssl_*` directives until certbot has populated them.
server {
    listen 80;
    server_name ${VOIDMAIL_DOMAIN};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

# ---- www -> apex (HTTP only) ----
# Audit v2 flagged that hitting http://www.qloak.me would 301 to
# https://www.qloak.me, but the LE cert covers only the apex — users
# saw a TLS error instead of content. We handle www at the HTTP layer
# and redirect to the apex URL on HTTPS so no www-prefixed hostname is
# ever presented over TLS with this cert. (If we ever issue a SAN cert
# covering www, this block can be deleted.)
server {
    listen 80;
    server_name www.${VOIDMAIL_DOMAIN};
    location /.well-known/acme-challenge/ { root /var/www/certbot; }
    location / {
        return 301 https://${VOIDMAIL_DOMAIN}$request_uri;
    }
}

# ---- MTA-STS policy host ----
# RFC 8461 requires the policy file to be served over HTTPS at
#   https://mta-sts.<domain>/.well-known/mta-sts.txt
# DNS prerequisites (set at the registrar):
#   mta-sts.qloak.me.       IN A     <vps-ip>
#   _mta-sts.qloak.me.      IN TXT   "v=STSv1; id=2026051001"
#   _smtp._tls.qloak.me.    IN TXT   "v=TLSRPTv1; rua=mailto:tls-reports@qloak.me"
# Re-issue the LE cert with -d mta-sts.${VOIDMAIL_DOMAIN} added before
# enabling this block.
server {
    listen 80;
    server_name mta-sts.${VOIDMAIL_DOMAIN};
    location /.well-known/acme-challenge/ { root /var/www/certbot; }
    location / { return 301 https://$host$request_uri; }
}
server {
    listen 443 ssl;
    http2 on;
    server_name mta-sts.${VOIDMAIL_DOMAIN};
    ssl_certificate     /etc/letsencrypt/live/${VOIDMAIL_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${VOIDMAIL_DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
    location = /.well-known/mta-sts.txt {
        proxy_pass http://voidmail_web;
        proxy_set_header Host $host;
        # MTA-STS spec recommends short cache, default-deny on errors.
        expires 5m;
        default_type text/plain;
    }
    location / { return 404; }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${VOIDMAIL_DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${VOIDMAIL_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${VOIDMAIL_DOMAIN}/privkey.pem;

    # TLS 1.2+ only. TLS 1.3 cipher suites are negotiated by OpenSSL
    # automatically; the ssl_ciphers list applies to TLS 1.2 only and
    # restricts to forward-secret AEAD suites.
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_prefer_server_ciphers off;
    ssl_ecdh_curve X25519:secp384r1;

    # Session resumption — perf only, no security cost.
    ssl_session_cache shared:TLS:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    # OCSP stapling intentionally disabled — Let's Encrypt phased out
    # OCSP responder URLs from new certs in early 2026, and stapling
    # against a cert without an OCSP URL is a no-op (and emits a
    # nginx warning at every reload). Modern revocation checking
    # happens via browser CRLite / CRLSet, not OCSP.

    # ---- Security headers ----
    # HSTS, two-year max-age + includeSubDomains + preload so the
    # domain becomes eligible for the Chromium HSTS preload list.
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" always;

    # Anti-framing / sniffing / referrer leakage.
    add_header X-Frame-Options DENY always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    # Modern guidance is to DISABLE the legacy XSS filter — its
    # heuristics created vulnerabilities of their own. CSP replaces it.
    add_header X-XSS-Protection "0" always;

    # CSP — strict; SPA is self-hosted, OpenPGP.js is bundled, no inline scripts.
    # 'wasm-unsafe-eval' is needed for the Argon2id (hash-wasm) password-key
    # derivation. It's strictly narrower than 'unsafe-eval' — only WebAssembly
    # is permitted, regular JS eval() is still blocked. style-src keeps
    # 'unsafe-inline' for now because the SPA writes inline style attributes
    # for the ripple effect; removing it requires nonce-based inline styles.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; connect-src 'self'; img-src 'self' data:; font-src 'self' data:; media-src 'self' data:; manifest-src 'self'; worker-src 'self'; object-src 'none'; frame-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests" always;

    # Cross-origin isolation — locks the top-level browsing context to
    # same-origin so cross-origin windows can't reference us, and our
    # resources can't be embedded anywhere else.
    add_header Cross-Origin-Opener-Policy "same-origin" always;
    add_header Cross-Origin-Resource-Policy "same-origin" always;
    add_header Cross-Origin-Embedder-Policy "require-corp" always;

    # Permissions-Policy — disable every browser capability the SPA
    # doesn't use, so an XSS payload can't trigger camera, mic,
    # geolocation, USB, etc. clipboard-write is allowed self-only so
    # the "copy onion address" / "copy recovery code" buttons work.
    add_header Permissions-Policy "accelerometer=(), ambient-light-sensor=(), autoplay=(), battery=(), bluetooth=(), camera=(), clipboard-read=(), clipboard-write=(self), display-capture=(), encrypted-media=(), fullscreen=(self), gamepad=(), geolocation=(), gyroscope=(), hid=(), idle-detection=(), local-fonts=(), magnetometer=(), microphone=(), midi=(), payment=(), picture-in-picture=(), publickey-credentials-get=(self), screen-wake-lock=(), serial=(), storage-access=(), usb=(), web-share=(), xr-spatial-tracking=()" always;

    client_max_body_size 30m;

    location /api/ {
        proxy_pass http://voidmail_api;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Block the internal API surface from the public side.
    location /api/v1/internal/ {
        return 404;
    }

    location / {
        proxy_pass http://voidmail_web;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
    }
}
