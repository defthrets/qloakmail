# VoidMail reverse proxy.
# Local dev: HTTP only on :8080.
# Production: ports 80/443, with cert from /etc/letsencrypt/live/${VOIDMAIL_DOMAIN}/.

upstream voidmail_api {
    server api:8000;
    keepalive 32;
}

upstream voidmail_web {
    server web:80;
    keepalive 16;
}

# ---- Local dev (HTTP on :8080) ----
server {
    listen 8080 default_server;
    server_name _;

    client_max_body_size 30m;

    location /api/ {
        proxy_pass http://voidmail_api;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection        "";
    }

    location / {
        proxy_pass http://voidmail_web;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
    }
}

# ---- Tor hidden service (HTTP on :80, anything ending in .onion) ----
# Tor provides E2E encryption between client and the hidden-service
# rendezvous, so no TLS on the hop from tor -> nginx -> upstream. We
# strip every header that could correlate the request to a clearnet
# identity (X-Forwarded-For, X-Real-IP), and we don't pass $host
# through to the API so it can't log the .onion either.
server {
    listen 80;
    server_name "~^.+\.onion$";

    client_max_body_size 30m;

    # Block the internal-only API surface from the public side.
    location /api/v1/internal/ { return 404; }

    location /api/ {
        proxy_pass http://voidmail_api;
        proxy_http_version 1.1;
        # Pass a fixed Host so logs/templates can't pick up the onion.
        proxy_set_header Host                ${VOIDMAIL_DOMAIN};
        proxy_set_header X-Real-IP           "";
        proxy_set_header X-Forwarded-For     "";
        proxy_set_header X-Forwarded-Proto   "https";
        proxy_set_header Connection          "";
    }

    location / {
        proxy_pass http://voidmail_web;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
    }
}

# ---- Production HTTPS ----
# Activated only once Let's Encrypt has issued a cert.
# Comment-out the `ssl_*` directives until certbot has populated them.
server {
    listen 80;
    server_name ${VOIDMAIL_DOMAIN};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    server_name ${VOIDMAIL_DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${VOIDMAIL_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${VOIDMAIL_DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers EECDH+AESGCM:EDH+AESGCM;
    ssl_prefer_server_ciphers on;

    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
    add_header X-Frame-Options DENY always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    # CSP — strict; SPA is self-hosted, OpenPGP.js is bundled, no inline scripts.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self'; img-src 'self' data:; frame-ancestors 'none'; base-uri 'self'" always;

    client_max_body_size 30m;

    location /api/ {
        proxy_pass http://voidmail_api;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Block the internal API surface from the public side.
    location /api/v1/internal/ {
        return 404;
    }

    location / {
        proxy_pass http://voidmail_web;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
    }
}
