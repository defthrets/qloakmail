# QloakMail environment configuration
# Copy to .env and fill in values for local dev / production.

# ---- Domain ----
VOIDMAIL_DOMAIN=voidmail.local
VOIDMAIL_HOSTNAME=mx.voidmail.local
# Comma-separated list of additional domains served (optional)
VOIDMAIL_EXTRA_DOMAINS=

# ---- Public URL of the webmail / API ----
VOIDMAIL_PUBLIC_URL=http://localhost:8080

# ---- PostgreSQL ----
POSTGRES_USER=voidmail
POSTGRES_PASSWORD=changeme_dev_only
POSTGRES_DB=voidmail
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ---- Redis ----
REDIS_HOST=redis
REDIS_PORT=6379

# ---- API ----
# 32+ random bytes, base64. Used to sign session tokens.
API_SECRET_KEY=replace_me_with_openssl_rand_base64_48
API_BIND=0.0.0.0:8000
# Comma-separated invite codes accepted at signup (launch phase).
# Empty string = open registration (still gated by captcha).
INVITE_CODES=
# ALTCHA / Turnstile config (optional in dev)
CAPTCHA_PROVIDER=none      # none | altcha | turnstile
CAPTCHA_SECRET=

# ---- Mail server ----
DOVECOT_LMTP_HOST=dovecot
DOVECOT_LMTP_PORT=24
ENCRYPT_PIPE_BIND=0.0.0.0:10025
# API host the encryption pipe queries for recipient pubkeys
INTERNAL_API_URL=http://api:8000
INTERNAL_API_TOKEN=replace_me_internal_token

# ---- Rspamd ----
RSPAMD_PASSWORD=changeme_dev_only

# ---- DKIM ----
# Selector used in DNS (e.g. "mail" -> mail._domainkey.voidmail.local)
DKIM_SELECTOR=mail

# ---- TLS / Let's Encrypt (production) ----
LETSENCRYPT_EMAIL=admin@voidmail.local
# Set to 1 to use the Let's Encrypt staging endpoint while testing.
LETSENCRYPT_STAGING=1

# ---- Admin panel ----
# Comma-separated list of email addresses that can access /api/v1/admin/*.
# Empty list disables the admin panel entirely.
ADMIN_EMAILS=

# HMAC secret for IP-ban fingerprints. Persisted (unlike the per-process
# rate-limit secret) so an IP stays banned across restarts. Defaults to
# a derivative of API_SECRET_KEY if blank — only set this if you want
# IP bans to survive an api_secret_key rotation.
IP_BAN_SECRET=

# Public registration. Default is closed -- accounts created out-of-band.
# Set to "true" to re-open the /auth/register endpoint.
REGISTRATION_ENABLED=false
